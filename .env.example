# Copy this file to .env for local overrides, or run:
# python3 scripts/update_env_from_ls.py

# Next.js server runtime
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=0.0.0.0
PORT=8080
NODE_OPTIONS=--max-old-space-size=128

# Runtime logging
PYTHONUNBUFFERED=1
QSYS_LOG_LEVEL=WARNING

# Queue API endpoint used by the Python interceptor
QSYS_QUEUE_URL=http://127.0.0.1:8080/api/v1/queue

# Set to 1 only if your keypad reports normal number-row keycodes instead of
# keypad keycodes.
QSYS_ACCEPT_ROW_DIGITS=0

# Queue display behavior
QSYS_MAX_VISIBLE_ORDERS=3
QSYS_FLASH_DURATION_MS=10000
QSYS_SSE_HEARTBEAT_MS=15000
QSYS_AUTO_RELOAD_INTERVAL_MS=300000

# USB keypad input device paths. Find these with:
# ls -l /dev/input/by-path/
FOOD_DEVICE_PATH=
DRINKS_DEVICE_PATH=
CHICKEN_DEVICE_PATH=
