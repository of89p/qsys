[Unit]
Description=QSys queue web server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=yy
WorkingDirectory=/home/yy/nus/qsys
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/yy/nus/qsys/.venv/bin/python /home/yy/nus/qsys/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
