[Unit]
Description=QSys keyboard interceptor
Requires=qsys-server.service
After=qsys-server.service

[Service]
Type=simple
User={{QSYS_USER}}
SupplementaryGroups=input
WorkingDirectory={{QSYS_ROOT}}
Environment=PYTHONUNBUFFERED=1
Environment=QSYS_LOG_LEVEL=WARNING
# FOOD_DEVICE_PATH, DRINKS_DEVICE_PATH, and CHICKEN_DEVICE_PATH come from .env,
# refreshed before interceptor startup by scripts/update_keypad_env.py.
EnvironmentFile=-{{QSYS_ENV_FILE}}
ExecStartPre={{QSYS_PYTHON}} {{QSYS_ROOT}}/scripts/update_keypad_env.py --env-file {{QSYS_ENV_FILE}} --example-file {{QSYS_ROOT}}/.env.example --device-dir {{QSYS_DEVICE_DIR}} --order {{QSYS_DEVICE_ORDER}}
ExecStart={{QSYS_PYTHON}} -m interceptor
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
