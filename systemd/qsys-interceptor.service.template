[Unit]
Description=QSys keyboard interceptor
Requires=qsys-server.service
After=qsys-server.service

[Service]
Type=simple
User={{QSYS_USER}}
SupplementaryGroups=input
WorkingDirectory={{QSYS_ROOT}}
Environment=PYTHONUNBUFFERED=1
Environment=QSYS_LOG_LEVEL=WARNING
# FOOD_DEVICE_PATH, DRINKS_DEVICE_PATH, and CHICKEN_DEVICE_PATH come from .env,
# generated from /dev/input/by-path by scripts/update_keypad_env.py.
EnvironmentFile=-{{QSYS_ENV_FILE}}
ExecStart={{QSYS_PYTHON}} -m interceptor
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
