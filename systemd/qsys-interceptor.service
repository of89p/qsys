[Unit]
Description=QSys keyboard interceptor
Requires=qsys-server.service
After=qsys-server.service

[Service]
Type=simple
User=yy
SupplementaryGroups=input
WorkingDirectory=/home/yy/nus/qsys
Environment=PYTHONUNBUFFERED=1
Environment=QSYS_QUEUE_URL=http://127.0.0.1:8080/api/queue
Environment=FOOD_DEVICE_PATH=/dev/input/by-id/usb-Logitech_USB_Receiver-if02-event-kbd
# When the second keypad is plugged in, uncomment and change this to its by-id path:
# Environment=DRINKS_DEVICE_PATH=/dev/input/by-id/usb-...
ExecStart=/home/yy/nus/qsys/.venv/bin/python /home/yy/nus/qsys/interceptor.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
